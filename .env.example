# ==============================================================================
# QUBIZON DIGITAL SOLUTIONS — PRODUCTION & DEVELOPMENT ENVIRONMENT CONFIGURATION
# ==============================================================================
#
# IMPORTANT SECURITY RULES:
# 1. Never commit actual secret keys or credentials to version control.
# 2. Copy this file to '.env.local' for local development.
# 3. All secrets are SERVER-ONLY. Never prefix them with NEXT_PUBLIC_.
# 4. In production, configure these variables directly in your hosting platform dashboard.

# ------------------------------------------------------------------------------
# 1. Google Sheets Lead Capture (Recommended — No Server Database Required)
# ------------------------------------------------------------------------------
# Directly save all website leads, discovery calls, and enquiries into a Google Sheet.
# See scripts/google-apps-script.js for the 1-minute setup guide.
GOOGLE_SHEETS_WEBHOOK_URL=""

# ------------------------------------------------------------------------------
# 2. Database Configuration (Optional: MariaDB 10.4.32 or PostgreSQL 15+)
# ------------------------------------------------------------------------------
# Select target database engine: 'sheets' | 'mariadb' | 'mysql' | 'postgres'
# Use 'sheets' if you want leads saved directly to Google Sheets without a local server DB.
DB_ENGINE="sheets"

# Option A: Connection URL format (Supported for both MariaDB and PostgreSQL)
# MariaDB/MySQL Example: mysql://qubizon_user:your_password@127.0.0.1:3306/qubizon
# PostgreSQL Example: postgresql://qubizon_user:your_password@ep-sample-123.us-east-2.aws.neon.tech/qubizon?sslmode=require
DATABASE_URL=""

# Option B: Discrete Parameters for Local MariaDB / phpMyAdmin (127.0.0.1:3306)
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_NAME="qubizon"
DB_USER="root"
DB_PASSWORD=""

# Explicit mock database override flag.
# Set to "false" (or leave unset) in production to ensure ephemeral mock storage is NEVER silently used.
# Set to "true" in local development or CI testing environments when a live database instance is absent.
ALLOW_MOCK_DB="false"

# ------------------------------------------------------------------------------
# 2. Email Notification Pipeline (Outbox Dispatcher)
# ------------------------------------------------------------------------------
# Delivery provider to use: 'mock' (default in dev/test) or 'resend'
EMAIL_PROVIDER="mock"

# API Key for transactional provider (required if EMAIL_PROVIDER="resend")
EMAIL_API_KEY=""

# Verified sender address belonging to the configured domain
EMAIL_FROM="Qubizon Enquiries <notifications@qubizon.com>"

# Primary notification recipient for client enquiries
EMAIL_TO="hello@qubizon.com"

# Secret token used to authorize recurring outbox retry cron workers at /api/cron/process-outbox
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# ------------------------------------------------------------------------------
# 3. Abuse Protection & Rate Limiting
# ------------------------------------------------------------------------------
# Maximum number of enquiries allowed per IP hash per hour window (default: 5)
RATE_LIMIT_MAX_PER_HOUR="5"

# Salt used to one-way hash client IP addresses to preserve privacy in audit logs
# Generate with: openssl rand -hex 32
IP_HASH_SALT="change_this_to_a_random_secret_salt_in_production"

# ------------------------------------------------------------------------------
# 4. Optional Client-Side Analytics & Tag Management
# ------------------------------------------------------------------------------
# Google Analytics 4 Measurement ID (Format: G-XXXXXXXXXX)
# Leave blank until your verified GA4 property is created.
NEXT_PUBLIC_GA_ID=""

# Google Tag Manager Container ID (Format: GTM-XXXXXXX)
# Leave blank until your verified GTM container is approved.
NEXT_PUBLIC_GTM_ID=""

# Microsoft Clarity Project ID
# Leave blank until your verified Clarity project is active.
NEXT_PUBLIC_CLARITY_ID=""

