# ==============================================================================
# QUBIZON DIGITAL SOLUTIONS — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to '.env.local' for local development.
# In production on your VPS, configure these in /var/www/qubizon/.env.local.

# ------------------------------------------------------------------------------
# 1. Google Sheets Lead Capture
# ------------------------------------------------------------------------------
# Webhook URL from your deployed Google Apps Script (see scripts/google-apps-script.js)
GOOGLE_SHEETS_WEBHOOK_URL=""
DB_ENGINE="sheets"

# ------------------------------------------------------------------------------
# 2. Optional Client Analytics (Leave blank until ready)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_CLARITY_ID=""
